DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pamahe_db
DB_USER=pamahe_backup
DB_PASSWORD=REEMPLAZAR
BACKUP_DIR=/var/backups/pamahe/mysql
BACKUP_RETENTION_DAYS=14
BACKUP_REQUIRE_REMOTE=true
BACKUP_REMOTE=backup@backup.example.com:/srv/backups/pamahe
# Para backup-verify.env, usar una cuenta diferente con permisos de creación,
# restauración y borrado SOLO sobre el prefijo de bases temporales.
VERIFY_DB_PREFIX=pamahe_restore_verify
