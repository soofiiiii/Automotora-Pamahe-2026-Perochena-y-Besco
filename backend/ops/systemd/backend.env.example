# Copiar fuera del repositorio: propietario root:pamahe y chmod 640.
# Este archivo es para systemd EnvironmentFile, no para ejecutar como script.

SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/pamahe_db?serverTimezone=America/Montevideo
DB_USER=pamahe
DB_PASSWORD=REEMPLAZAR
JWT_SECRET=REEMPLAZAR_POR_BASE64_DE_32_BYTES_ALEATORIOS
FRONTEND_URL=https://app.example.com
STORAGE_ROOT=/var/lib/pamahe/uploads
LOG_FILE=/var/log/pamahe/backend.log
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_AL_INSTALAR
