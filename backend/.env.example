# Perfil de ejecución
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

# Base de datos
DB_NAME=pamahe_db
DB_URL=jdbc:mysql://localhost:3307/pamahe_db?useSSL=false&serverTimezone=America/Montevideo&allowPublicKeyRetrieval=true
DB_USER=usuario_mysql
DB_PASSWORD=contrasena_mysql
DB_ROOT_PASSWORD=contrasena_root_mysql

# Seguridad JWT
JWT_SECRET=clave_jwt_segura_en_base64
JWT_ISSUER=pamahe-api
JWT_EXPIRATION_MINUTES=120

# Bootstrap administrativo. En producción debe provenir de un secreto externo.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=clave_inicial_segura_de_al_menos_12_caracteres

# Protección de login
LOGIN_MAX_ATTEMPTS_USER=5
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=900

# Aplicación
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080/api
FORWARD_HEADERS_STRATEGY=native

# Almacenamiento de imágenes
STORAGE_ROOT=uploads
MAX_IMAGE_FILE_SIZE=12MB
MAX_IMAGE_REQUEST_SIZE=64MB
IMAGE_MAX_BYTES=12582912
IMAGE_MAX_WIDTH=8000
IMAGE_MAX_HEIGHT=8000
IMAGE_MAX_PIXELS=24000000
IMAGE_MAX_OUTPUT_DIMENSION=1920

# Logs
LOG_FILE=logs/pamahe-backend.log
APP_VERSION=dev

# Reverse proxy TLS (ops/nginx/render-config.sh)
PAMAHE_API_HOST=api.ejemplo.com
PAMAHE_BACKEND_PORT=8080
TLS_CERTIFICATE=/etc/letsencrypt/live/api.ejemplo.com/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/api.ejemplo.com/privkey.pem

# Backups MySQL (scripts ops/backup)
DB_HOST=localhost
DB_PORT=3307
BACKUP_DIR=/var/backups/pamahe/mysql
BACKUP_RETENTION_DAYS=14
RESTORE_CONFIRM=NO

# Seguimiento postventa (días desde la venta y cron diario)
SEGUIMIENTO_POSTVENTA_DIAS=7
SEGUIMIENTO_POSTVENTA_CRON=0 0 9 * * *

# Próximo mantenimiento (anticipación del aviso y cron diario)
MANTENIMIENTO_AVISO_DIAS=7
MANTENIMIENTO_CRON=0 15 9 * * *
