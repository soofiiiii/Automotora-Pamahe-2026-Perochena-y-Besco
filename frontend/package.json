{
  "name": "frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "preview": "vite preview",
    "test:e2e": "node e2e/browser-flow.mjs",
    "check:full": "npm run check && npm run test:e2e && npm run test:responsive && npm run test:accessibility && npm run test:pagination:static && npm run test:seo",
    "test:responsive": "node e2e/responsive-validation.mjs",
    "test:accessibility": "node e2e/accessibility-validation.mjs",
    "test:accessibility:static": "node e2e/accessibility-validation.mjs --static",
    "seo:generate": "node scripts/generate-seo.mjs",
    "test:pagination:static": "node e2e/pagination-validation.mjs",
    "test:seo": "node e2e/seo-validation.mjs",
    "test:e2e:real": "node e2e/real-stack-flow.mjs",
    "test:accessibility:axe": "npm exec --yes --package=axe-core@4.13.0 -- node e2e/axe-standard-validation.mjs",
    "test:accessibility:lighthouse": "node e2e/lighthouse-accessibility.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "axios": "^1.16.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
